<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".PhoneNumber">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_bg">

        <!-- Back Button  -->

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/dark_blue" />

        <!-- Main Content -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/member_verification_code_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_4_digit_code"
                android:textAlignment="center"
                android:textColor="@color/dark_blue"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp" />

            <TextView
                android:id="@+id/member_ver_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="code"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:layout_marginTop="80px"
                android:layout_marginBottom="20dp" />

            <!--Enter verification code-->

            <EditText
                android:id="@+id/member_four_digit_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/code_hint"
                android:inputType="numberPassword"
                android:padding="12dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/text_gray"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLength="15"
                android:layout_marginBottom="20dp" />

            <!--confirm OTP-->

            <androidx.cardview.widget.CardView
                android:id="@+id/member_confirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1565C0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/confirm_button"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- resend code -->

            <TextView
                android:id="@+id/code_confirm_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="textEnd"
                android:textSize="12sp"
                android:textColor="@color/blue"
                android:text="@string/resend_code"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
