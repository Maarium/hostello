<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:text="Hostel Details Submission"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"/>

        <!-- Hostel Name -->
        <EditText
            android:id="@+id/etHostelName"
            android:hint="Hostel Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Hostel Address -->
        <EditText
            android:id="@+id/etHostelAddress"
            android:hint="Hostel Address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- Facilities -->
        <EditText
            android:id="@+id/etFacilities"
            android:hint="Facilities (WiFi, Mess, Laundry etc.)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- Room Images -->
        <TextView
            android:text="Upload Hostel Room Images"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnRoomImages"
            android:text="Select Room Images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Furniture Images -->
        <TextView
            android:text="Upload Furniture Images"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnFurnitureImages"
            android:text="Select Furniture Images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Facilities Images -->
        <TextView
            android:text="Upload Facilities Images"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnFacilityImages"
            android:text="Select Facilities Images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Submit -->
        <Button
            android:id="@+id/btnSubmit"
            android:text="Submit Details"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
