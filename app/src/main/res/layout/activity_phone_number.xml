<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp"
    tools:context=".PhoneNumber">

    <!-- Gradient card section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_bg"
        android:padding="20dp">

        <!-- Vertical container for logo, texts, input, button, and terms text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Small Logo -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/splash"
                android:scaleType="fitCenter"
                android:layout_marginBottom="20dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/phone_input_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Enter_your_Phone_Number"
                android:textAlignment="center"
                android:textColor="@color/dark_blue"
                android:textSize="28sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/phone_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/We_will_send_you_a_verifivation_code"
                android:textAlignment="center"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="20dp" />

            <!-- Phone Number Input Field -->
            <EditText
                android:id="@+id/phone_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/countrycode"
                android:inputType="phone"
                android:padding="12dp"
                android:textColor="@color/blue"
                android:textColorHint="@color/dark_blue"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLength="15"
                android:layout_marginBottom="20dp"
                android:imeOptions="actionNext"
                android:focusable="true" />

            <!-- Continue Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/continue_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1565C0"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/continue_button"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

            </androidx.cardview.widget.CardView>

            <!-- Terms / agreement text RIGHT AFTER the Continue button -->
            <TextView
                android:id="@+id/phone_continue_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                android:textAlignment="center"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:autoLink="none"
                android:linksClickable="true"
                android:text="By clicking Continue button you are agreeing to our terms of use" />

        </LinearLayout>

        <!-- Back Button ON TOP of gradient section -->
        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/dark_blue" />

    </FrameLayout>

</LinearLayout>
